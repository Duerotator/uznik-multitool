# Obtain your own API credentials at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_DEFAULT_BACKEND=pyrogram
TELEGRAM_DATA_DIR=data
TELEGRAM_IMPORT_DIR=imports
TELEGRAM_MAX_CONCURRENCY=3
TELEGRAM_MIN_ACTION_DELAY=1
TELEGRAM_MAX_ACTION_DELAY=4

# Optional: configure your OWN proxy; no proxies or subscriptions are supplied.
TELEGRAM_GLOBAL_PROXY=
PROXY_MODE=manual
PROXY_SOURCE_URLS=

# Optional shared password for Telegram Web. Empty = enter 2FA manually.
TELEGRAM_DIRECT_ACCESS_2FA_PASSWORD=

# Optional AI companion. Use your own provider/key/model.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
AI_ALLOWED_CHATS=

# Email codes: http (unique domain aliases), imap or pop3 (your mailbox list).
EMAIL_INBOX_BACKEND=http
EMAIL_DOMAIN=
EMAIL_INBOX_API_URL=
EMAIL_INBOX_TOKEN=
EMAIL_MAILBOXES_FILE=imports/emails/accounts.txt
# Blank host = per-line host or known Rambler/Mail.ru domain; port 0 = TLS 993/995.
EMAIL_MAILBOX_HOST=
EMAIL_MAILBOX_PORT=0
EMAIL_MAILBOX_FOLDER=INBOX
EMAIL_MAILBOX_SOCKET_TIMEOUT=15
EMAIL_MAILBOX_POLL_INTERVAL=4

# Optional local Xray gateway: set PROXY_MODE=vpn_gateway only after configuring.
XRAY_EXECUTABLE=
VPN_VLESS_SUBSCRIPTION_URL=
VPN_VLESS_FILE=
VPN_XRAY_SUBSCRIPTION_URL=
VPN_GATEWAY_REFRESH_MINUTES=360

# Keep browser-based giveaway participation conservative.
GIVEAWAY_BROWSER_MAX_CONCURRENCY=1
GIVEAWAY_REFERRAL_BATCH_SIZE=1

# Optional paid captcha provider for giveaway flows that require it.
SOLVECAPTCHA_KEY=
